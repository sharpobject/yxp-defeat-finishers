<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ILRuntime.Mono.Cecil"><HintPath>$(GameManaged)/ILRuntime.Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireGameManaged" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameManaged)' == ''" Text="Pass GameManaged for the selected current native input; no historical default is permitted." />
  </Target>
</Project>
