{
  "id": "com.sharpobject.defeatfinishers",
  "name": "鸭神与压路机",
  "version": "0.1.3",
  "author": "sharpobject",
  "description": "屠馗瞬狱杀与林小月时停压路机淘汰演出；替换满足条件的整回合动画，保留原场景、角色外观和实际伤害飘字。",
  "sdkVersion": ">=1.0.0 <2.0.0",
  "entry": "plugins/YxpDefeatFinishers.dll",
  "entryType": "YxpDefeatFinishers.FinisherMod",
  "provides": {
    "hooks": [
      "BattleExecuter.Execute",
      "BattleExecuter.SetVisible",
      "BattleCharacter.OnTurnStarted",
      "CardActionBase.Execute",
      "CardActionBase.ExecuteEffect",
      "BattleCharacter.Attack",
      "BattleExecuter.ResurrectionCheckAsync",
      "BattleCharacter.MoveTo",
      "BattleCharacter.Return",
      "BattleCharacter.Cast",
      "CharacterBattleAnimator.PlayAnimation",
      "CharacterBattleAnimator.AddAnimation",
      "CharacterBattleAnimator.WaitForEvent",
      "CharacterBattleAnimator.WaitForEnd",
      "BattleExecuter.PlaySound",
      "BattleCharacter.OnBlockSucceed",
      "BattleCharacter.OnBlockFailed",
      "BattleCharacter.OnBattleWin",
      "BattleCharacter.SpawnDefeatEffect",
      "BattleExecuter.OnEnd",
      "BattleExecuter.OnDestroy",
      "BattleManager.OnDestroy",
      "BattleManager.ChangeSceneType",
      "CharacterBattleAnimatorPool.Despawn",
      "CharacterBattleAnimatorPool.ResetInstance"
    ]
  }
}
